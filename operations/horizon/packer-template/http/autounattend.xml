<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <!--
    autounattend.xml - Windows 11 24H2 Enterprise
    Packer vsphere-iso / floppy_files delivery (A:\)

    FirstLogonCommands write progress to C:\Windows\Temp\packer-flc.log
    so we can diagnose failures even before WinRM is available.
  -->

  <settings pass="windowsPE">

    <component name="Microsoft-Windows-International-Core-WinPE"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>nb-NO</InputLocale>
      <SystemLocale>nb-NO</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>nb-NO</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

      <ProductKey>
        <WillShowUI>Never</WillShowUI>
        <Key>NPPR9-FWDCX-D2C8J-H872K-2YT43</Key>
      </ProductKey>

      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add HKLM\System\Setup\LabConfig /v BypassTPMCheck /t reg_dword /d 0x00000001 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add HKLM\System\Setup\LabConfig /v BypassSecureBootCheck /t reg_dword /d 0x00000001 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add HKLM\System\Setup\LabConfig /v BypassRAMCheck /t reg_dword /d 0x00000001 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>reg add HKLM\System\Setup\LabConfig /v BypassStorageCheck /t reg_dword /d 0x00000001 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>reg add HKLM\System\Setup\LabConfig /v BypassCPUCheck /t reg_dword /d 0x00000001 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>

      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>EFI</Type>
              <Size>512</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>MSR</Type>
              <Size>128</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Format>FAT32</Format>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>2</PartitionID>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>3</Order>
              <PartitionID>3</PartitionID>
              <Format>NTFS</Format>
              <Label>Windows</Label>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>

      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 11 Enterprise</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
          <WillShowUI>OnError</WillShowUI>
        </OSImage>
      </ImageInstall>

      <UserData>
        <AcceptEula>true</AcceptEula>
        <ProductKey>
          <Key>NPPR9-FWDCX-D2C8J-H872K-2YT43</Key>
          <WillShowUI>Never</WillShowUI>
        </ProductKey>
      </UserData>

    </component>
  </settings>

  <settings pass="offlineServicing">
    <component name="Microsoft-Windows-LUA-Settings"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <EnableLUA>false</EnableLUA>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <ComputerName>PACKERBUILD</ComputerName>
      <TimeZone>W. Europe Standard Time</TimeZone>
      <RegisteredOrganization>Contoso</RegisteredOrganization>
      <RegisteredOwner>Windows User</RegisteredOwner>
    </component>
    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <InputLocale>0409:00000409</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
  </settings>

  <settings pass="oobeSystem">

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

      <UserAccounts>
        <AdministratorPassword>
          <Value>SommerFerie2020!</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>
      </UserAccounts>

      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>Administrator</Username>
        <Domain>.</Domain>
        <Password>
          <Value>SommerFerie2020!</Value>
          <PlainText>true</PlainText>
        </Password>
        <LogonCount>999</LogonCount>
      </AutoLogon>

      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <ProtectYourPC>3</ProtectYourPC>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
        <SkipMachineOOBE>true</SkipMachineOOBE>
      </OOBE>

      <FirstLogonCommands>

        <!-- LOG: Start -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] FLC START > C:\Windows\Temp\packer-flc.log</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Set execution policy -->
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Setting execution policy >> C:\Windows\Temp\packer-flc.log &amp; powershell -Command "Set-ExecutionPolicy Bypass -Scope LocalMachine -Force"</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Enable Administrator -->
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Enabling Administrator >> C:\Windows\Temp\packer-flc.log &amp; net user Administrator SommerFerie2020! /active:yes</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Create directories -->
        <SynchronousCommand wcm:action="add">
          <Order>4</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Creating directories >> C:\Windows\Temp\packer-flc.log &amp; mkdir C:\Temp 2>nul &amp; mkdir C:\Windows\Setup\Scripts 2>nul</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Log drive letters -->
        <SynchronousCommand wcm:action="add">
          <Order>5</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Drive listing: >> C:\Windows\Temp\packer-flc.log &amp; dir D:\ >> C:\Windows\Temp\packer-flc.log 2>&amp;1 &amp; dir E:\ >> C:\Windows\Temp\packer-flc.log 2>&amp;1 &amp; dir F:\ >> C:\Windows\Temp\packer-flc.log 2>&amp;1</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Install VMware Tools from E:\ -->
        <SynchronousCommand wcm:action="add">
          <Order>6</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Installing VMware Tools >> C:\Windows\Temp\packer-flc.log &amp; if exist E:\setup.exe (E:\setup.exe /s /v "/qb REBOOT=ReallySuppress ADDLOCAL=ALL /l*v C:\Temp\vmtools.log" &amp; echo [%TIME%] VMware Tools install started >> C:\Windows\Temp\packer-flc.log) else (echo [%TIME%] ERROR: E:\setup.exe not found >> C:\Windows\Temp\packer-flc.log)</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Wait 90s for VMware Tools -->
        <SynchronousCommand wcm:action="add">
          <Order>7</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Waiting 90s for VMware Tools >> C:\Windows\Temp\packer-flc.log &amp; ping 127.0.0.1 -n 91 &gt; nul</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Log VMware Tools result -->
        <SynchronousCommand wcm:action="add">
          <Order>8</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] VMware Tools wait done >> C:\Windows\Temp\packer-flc.log &amp; sc query VMTools >> C:\Windows\Temp\packer-flc.log 2>&amp;1</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Copy setup.ps1 from floppy -->
        <SynchronousCommand wcm:action="add">
          <Order>9</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Copying setup.ps1 >> C:\Windows\Temp\packer-flc.log &amp; copy A:\setup.ps1 C:\Windows\Setup\Scripts\setup.ps1 /Y &amp; copy A:\setup.ps1 C:\Temp\setup.ps1 /Y</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Enable WinRM -->
        <SynchronousCommand wcm:action="add">
          <Order>10</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Enabling WinRM >> C:\Windows\Temp\packer-flc.log &amp; powershell -ExecutionPolicy Bypass -File C:\Windows\Setup\Scripts\setup.ps1 >> C:\Windows\Temp\packer-flc.log 2>&amp;1</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Set RunOnce for WinRM after audit reboot -->
        <SynchronousCommand wcm:action="add">
          <Order>11</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Setting RunOnce >> C:\Windows\Temp\packer-flc.log &amp; reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce" /v WinRMSetup /t REG_SZ /d "cmd.exe /c powershell -ExecutionPolicy Bypass -File C:\Windows\Setup\Scripts\setup.ps1" /f</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Set registry execution policy -->
        <SynchronousCommand wcm:action="add">
          <Order>12</Order>
          <CommandLine>cmd.exe /c reg add "HKLM\SOFTWARE\Microsoft\PowerShell\1\ShellIds\Microsoft.PowerShell" /v ExecutionPolicy /t REG_SZ /d Unrestricted /f</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- LOG: Enter audit mode -->
        <SynchronousCommand wcm:action="add">
          <Order>13</Order>
          <CommandLine>cmd.exe /c echo [%TIME%] Entering audit mode via sysprep >> C:\Windows\Temp\packer-flc.log</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- Enter audit mode - MUST BE LAST -->
        <SynchronousCommand wcm:action="add">
          <Order>14</Order>
          <CommandLine>cmd.exe /c C:\Windows\System32\Sysprep\sysprep.exe /audit /reboot /quiet</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

      </FirstLogonCommands>

    </component>

    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <InputLocale>0409:00000409</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

  </settings>

</unattend>
